    "findRegex": "/<UpdateVariable(?:variable)?>(?=[\\s\\S]*<\\/UpdateVariable(?:variable)?>)\\s*(?:<analysis>\\s*([\\s\\S]*?)\\s*<\\/analysis>\\s*)?(?:<JSONPatch>\\s*([\\s\\S]*?)\\s*<\\/JSONPatch>\\s*)?([\\s\\S]*)<\\/UpdateVariable(?:variable)?>/gi",
    "replaceString": "<details data-kdn-settlement style=\"margin:10px 0;width:100%;max-width:100%;min-width:0;box-sizing:border-box;border-radius:12px;background:rgba(211,173,99,.06);border:.5px solid rgba(211,173,99,.22);overflow:hidden\"><summary style=\"cursor:pointer;padding:9px 14px;color:rgba(211,173,99,.9);font-size:12px;letter-spacing:.5px;user-select:none\">◈ 变量结算 · 已写入</summary><div data-kdn-settlement-scroll style=\"display:block;margin:0!important;max-height:180px;max-width:100%;min-width:0;box-sizing:border-box;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding:4px 14px 9px;scrollbar-width:thin;scrollbar-color:rgba(211,173,99,.42) transparent;touch-action:pan-y;-webkit-overflow-scrolling:touch\"><div style=\"margin:0 0 3px;color:rgba(255,255,255,.72);font-size:12px;font-weight:600;letter-spacing:.4px\">本轮变化</div><div data-kdn-settlement-analysis style=\"margin:0;max-width:100%;min-width:0;box-sizing:border-box;font-size:12px;line-height:1.35;color:rgba(255,255,255,.68);font-family:inherit;white-space:pre-line;overflow-wrap:anywhere;word-break:break-word\">$1$3</div><div style=\"margin-top:6px;border-top:.5px solid rgba(255,255,255,.08);padding-top:5px;color:rgba(255,255,255,.48);font-size:12px;font-weight:600;letter-spacing:.4px\">变量内容</div><pre data-kdn-settlement-patch style=\"margin:3px 0 0;max-width:100%;min-width:0;box-sizing:border-box;font-size:12px;line-height:1.35;color:rgba(255,255,255,.48);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word\">$2</pre></div></details>\n",
